{
  "name": "nova-browser",
  "version": "1.0.0",
  "description": "NOVA Browser — Fast, Private, Ad-Free Desktop Web Browser",
  "main": "dist/main/index.js",
  "author": "NOVA Browser Team",
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "dev:vite": "vite --config vite.config.ts",
    "build:vite": "vite build --config vite.config.ts",
    "build:main": "esbuild src/main/index.ts --bundle --platform=node --target=node20 --outfile=dist/main/index.js --external:electron",
    "build:preload": "esbuild src/preload/index.ts --bundle --platform=node --target=node20 --outfile=dist/preload/index.js --external:electron",
    "build": "npm run build:vite && npm run build:main && npm run build:preload",
    "dev": "concurrently -k \"npm run dev:vite\" \"wait-on tcp:5173 && npm run build:main && npm run build:preload && cross-env NODE_ENV=development electron .\"",
    "start": "electron .",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "package:dir": "npm run build && electron-builder --dir",
    "package:win": "npm run build && electron-builder --win nsis",
    "package:portable": "npm run build && electron-builder --win portable",
    "package:all": "npm run build && electron-builder --win nsis portable"
  },
  "build": {
    "appId": "com.novabrowser.app",
    "productName": "NOVA Browser",
    "copyright": "Copyright © 2026 NOVA Browser Authors",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NOVA Browser",
      "uninstallDisplayName": "${productName}",
      "deleteAppDataOnUninstall": false,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wait-on": "^9.5.1"
  },
  "dependencies": {
    "@ghostery/adblocker": "^2.20.1",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
